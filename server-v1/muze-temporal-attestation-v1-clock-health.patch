+    match env::var(name) {
+        Ok(v) => Ok(v.parse().map_err(|e| format!("invalid {name}={v:?}: {e}"))?),
+        Err(env::VarError::NotPresent) => Ok(default),
+        Err(e) => Err(e.into()),
+    }
+}
